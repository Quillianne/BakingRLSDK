{
  "name": "bakingrl-sdk-repository",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "create-bakingrl-plugin": "packages/create-bakingrl-plugin/bin/create-bakingrl-plugin.mjs",
    "bakingrl-plugin": "packages/create-bakingrl-plugin/lib/bakingrl-plugin.mjs"
  },
  "files": [
    "packages",
    "docs-src",
    "README.md"
  ],
  "workspaces": [
    "packages/plugin-sdk",
    "packages/create-bakingrl-plugin"
  ],
  "scripts": {
    "build": "npm run build --workspace @bakingrl/plugin-sdk",
    "check": "npm run build --workspace @bakingrl/plugin-sdk",
    "create": "node packages/create-bakingrl-plugin/bin/create-bakingrl-plugin.mjs",
    "helper": "node packages/create-bakingrl-plugin/lib/bakingrl-plugin.mjs",
    "docs:build": "quarkdown c docs-src/main.qd -o docs-site --clean --subdoc-naming file-name",
    "docs:dev": "quarkdown c docs-src/main.qd -o docs-site --clean --subdoc-naming file-name -p -w"
  },
  "license": "MIT"
}
