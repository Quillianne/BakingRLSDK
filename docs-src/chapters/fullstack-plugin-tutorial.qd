.docname {Fullstack Plugin Tutorial}
.docauthor {BakingRL}
.include {docs}
.doclang {en}

This tutorial builds the shape of a production-ready BakingRL package: one
visual, one backend service, package permissions, editor-only visual states,
runtime preview behavior, validation, packaging, and local installation.

The example is a compact match banner. The visual can show representative
states in the editor, while the service owns the runtime state derived from
Rocket League telemetry.

## 1. Create The Package

Install the generator, then create a package:

```sh
npm install -g @bakingrl/create-plugin
create-bakingrl-plugin match-banner
cd match-banner
npm install
```

When developing from a local SDK checkout, install the checkout globally first:

```sh
cd BakingRLSDK
npm install
npm run build
npm install -g . --force
```

Then create the package in your plugin workspace:

```sh
cd ../BakingRLPlugins
create-bakingrl-plugin match-banner
cd match-banner
npm install
```

The generated package already includes a visual, component, service, connector,
manifest, Vite config, and helper script. This tutorial focuses on the visual
and service path; remove unused exports later if the package does not need
them.

## 2. Declare The Runtime Surface

In `bakingrl.plugin.json`, keep the visual and service entries and request only
the event and state permissions needed by the package:

```json
{
  "exports": {
    "visuals": {
      "matchBanner": {
        "entry": "dist/visuals/match-banner.js",
        "defaultSize": [760, 128],
        "settings": "src/visuals/match-banner/settings.schema.json"
      }
    },
    "services": {
      "matchState": {
        "entry": "dist/services/match-state.js",
        "methods": ["snapshot", "reset"],
        "schema": "src/services/match-state/methods.schema.json"
      }
    }
  },
  "permissions": {
    "bus": {
      "read": ["UpdateState", "GoalScored", "MatchDestroyed", "plugin.com.example.match_banner.state"],
      "publish": ["plugin.com.example.match_banner.*"]
    },
    "registry": {
      "read": ["plugin.com.example.match_banner.*"],
      "write": ["plugin.com.example.match_banner.*"]
    },
    "network": {
      "http": [],
      "websocket": []
    },
    "storage": ["plugin://self/*"]
  }
}
```

Also update `vite.config.ts` so each manifest entry has a matching Rollup input
that emits the declared `dist/...js` file.

## 3. Add Visual Settings

Create `src/visuals/match-banner/settings.schema.json`:

```json
{
  "type": "object",
  "title": "Match Banner Settings",
  "properties": {
    "accent": {
      "type": "string",
      "format": "color",
      "default": "#38bdf8"
    },
    "showLastGoal": {
      "type": "boolean",
      "default": true
    }
  }
}
```

Instance settings appear in the page and layout editors. Package-level settings
use the top-level `settings` field instead.

## 4. Implement The Service

The service owns the runtime state. It subscribes to telemetry, writes the
latest snapshot to the registry, and publishes a package event for visuals that
are already mounted.

`src/services/match-state/index.ts`:

```ts
import { defineService, type ServiceContext } from "@bakingrl/plugin-sdk";

const stateKey = "plugin.com.example.match_banner.state";

type MatchState = {
  blue: string;
  orange: string;
  blueScore: number;
  orangeScore: number;
  lastGoal: string | null;
};

let state: MatchState = {
  blue: "Blue",
  orange: "Orange",
  blueScore: 0,
  orangeScore: 0,
  lastGoal: null
};

function publish(context: ServiceContext) {
  context.registry.set(stateKey, state);
  context.bus.emit(stateKey, state);
}

export default defineService({
  mount(context) {
    const offUpdate = context.bus.subscribe("UpdateState", (event) => {
      const teams = event.Data.Game.Teams;
      const blue = teams.find((team) => team.TeamNum === 0);
      const orange = teams.find((team) => team.TeamNum === 1);

      state = {
        ...state,
        blue: blue?.Name ?? "Blue",
        orange: orange?.Name ?? "Orange",
        blueScore: blue?.Score ?? 0,
        orangeScore: orange?.Score ?? 0
      };
      publish(context);
    });

    const offGoal = context.bus.subscribe("GoalScored", (event) => {
      state = {
        ...state,
        lastGoal: event.Data.Scorer.Name
      };
      publish(context);
    });

    const offDestroyed = context.bus.subscribe("MatchDestroyed", () => {
      state = {
        blue: "Blue",
        orange: "Orange",
        blueScore: 0,
        orangeScore: 0,
        lastGoal: null
      };
      publish(context);
    });

    return () => {
      offUpdate();
      offGoal();
      offDestroyed();
    };
  },
  methods: {
    snapshot() {
      return state;
    },
    reset(_input, context) {
      state = {
        blue: "Blue",
        orange: "Orange",
        blueScore: 0,
        orangeScore: 0,
        lastGoal: null
      };
      publish(context);
      return { ok: true };
    }
  }
});
```

The registry key and event name are intentionally the same here: the registry
stores the latest value, while the bus event notifies mounted visuals.

## 5. Implement The Visual

The visual renders runtime state and exposes editor-only states. The editor
actions do not publish to the host bus.

`src/visuals/match-banner/index.ts`:

```ts
import { defineVisual, setting, type VisualContext } from "@bakingrl/plugin-sdk";
import "./style.css";

const stateEvent = "plugin.com.example.match_banner.state";

type MatchState = {
  blue: string;
  orange: string;
  blueScore: number;
  orangeScore: number;
  lastGoal: string | null;
};

const fallbackState: MatchState = {
  blue: "Blue",
  orange: "Orange",
  blueScore: 0,
  orangeScore: 0,
  lastGoal: null
};

const instances = new Map<HTMLElement, MatchState>();

function render(context: VisualContext, state: MatchState) {
  const accent = setting(context.settings, "accent", "#38bdf8");
  const showLastGoal = setting(context.settings, "showLastGoal", true);

  const section = document.createElement("section");
  section.className = "match-banner";
  section.style.setProperty("--accent", accent);

  const blue = document.createElement("strong");
  blue.textContent = state.blue;

  const score = document.createElement("span");
  score.textContent = `${state.blueScore} - ${state.orangeScore}`;

  const orange = document.createElement("strong");
  orange.textContent = state.orange;

  section.append(blue, score, orange);

  if (showLastGoal && state.lastGoal) {
    const lastGoal = document.createElement("small");
    lastGoal.textContent = `${state.lastGoal} scored`;
    section.append(lastGoal);
  }

  context.root.replaceChildren(section);
}

function applyState(context: VisualContext, state: MatchState) {
  instances.set(context.root, state);
  render(context, state);
}

export default defineVisual({
  async mount(context) {
    context.root.className = "match-banner-root";
    applyState(context, fallbackState);

    const offState = context.bus.subscribe(stateEvent, (event) => {
      applyState(context, event.Data as MatchState);
    });

    if (context.mode === "runtime") {
      const snapshot = await context.services.call<MatchState>(
        "com.example.match_banner/matchState",
        "snapshot"
      );
      applyState(context, snapshot);
    }

    return () => {
      offState();
      instances.delete(context.root);
    };
  },
  update(context) {
    render(context, instances.get(context.root) ?? fallbackState);
  },
  editor: {
    mount(context) {
      context.editor?.emit(stateEvent, {
        blue: "Blue",
        orange: "Orange",
        blueScore: 1,
        orangeScore: 0,
        lastGoal: null
      } as MatchState);
    },
    actions() {
      return [
        {
          id: "tie-game",
          label: "Tie Game",
          run(context) {
            context.editor?.emit(stateEvent, {
              blue: "Blue",
              orange: "Orange",
              blueScore: 2,
              orangeScore: 2,
              lastGoal: null
            } as MatchState);
          }
        },
        {
          id: "blue-goal",
          label: "Blue Goal",
          run(context) {
            context.editor?.emit(stateEvent, {
              blue: "Blue",
              orange: "Orange",
              blueScore: 3,
              orangeScore: 2,
              lastGoal: "Blue Player"
            } as MatchState);
          }
        }
      ];
    }
  }
});
```

`src/visuals/match-banner/style.css`:

```css
.match-banner-root {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.match-banner {
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px;
  padding: 0 24px;
  color: white;
  background: rgba(10, 14, 18, 0.9);
  border-top: 3px solid var(--accent);
  font: 700 24px Inter, Arial, sans-serif;
}

.match-banner strong:last-of-type {
  text-align: right;
}

.match-banner small {
  grid-column: 1 / -1;
  color: var(--accent);
  font-size: 13px;
}
```

This visual starts with a stable fallback, then editor mode injects a local
state. Transient states, such as goals, are exposed through explicit actions
instead of firing automatically on mount.

## 6. Test In The Editor

Build and install locally:

```sh
npm run build
npm run check
npm run validate
npm run install:local
```

If the package lives inside a sibling `BakingRLPlugins` checkout, start
BakingRL from the host repository:

```sh
cd ../../BakingRL
npm run tauri dev
```

Then:

1. Open the Packages tab and enable the package.
2. Add `matchBanner` to a page or overlay layout.
3. Use the visual settings form to change `accent` and `showLastGoal`.
4. In editor mode, use the visual's editor actions to inspect states such as
   tie game and blue goal.
5. Switch to preview mode to mount the visual through the normal runtime path.

Editor mode confirms the visual states and layout. Preview mode confirms the
runtime chain: service startup, bus permissions, registry snapshot, service RPC,
settings, and mounted visual behavior.

## 7. Pack The Package

After local testing, create a bundle:

```sh
npm run pack
```

For signed local or marketplace-oriented bundles:

```sh
npm run keygen -- signing-key.json
npm run pack -- --sign signing-key.json
```

Do not commit signing keys, generated bundles, `dist/`, `dist-bundles/`,
`manifest.hashes.json`, or local machine files unless a release process
explicitly requires generated artifacts.

## 8. Review The Package Surface

Before sharing a package, inspect what the host will see:

```sh
npm run inspect
```

Check:

- runtime API compatibility is current;
- every export has a built entry or valid template path;
- settings schemas are readable;
- bus publish permissions stay in `plugin.<package-id>.*`;
- registry and storage permissions are package-scoped;
- network hosts are empty unless a connector truly needs them.

When the package README describes the same events, registry keys, settings, and
permissions shown by `inspect`, users and reviewers can understand the package
without reading the source.
