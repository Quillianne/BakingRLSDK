{
  "schemaVersion": "bakingrl.plugin/4",
  "bakingrlApi": "2.4.0",
  "id": "__PLUGIN_ID__",
  "name": "__PLUGIN_NAME__",
  "version": "1.0.0",
  "author": "Your Name",
  "permissions": {
    "bus": { "read": [], "publish": [] },
    "registry": { "read": [], "write": [] },
    "network": { "http": [], "websocket": [], "listen": [] },
    "storage": { "read": [], "write": [] }
  },
  "runtime": {
    "node": {
      "entry": "dist/extension/index.js"
    },
    "sidecars": [
      {
        "id": "native-helper",
        "bin": "sidecars/native-helper/target/release/__PLUGIN_SLUG__-sidecar",
        "args": [],
        "env": {},
        "platforms": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64"],
        "protocol": "jsonrpc-stdio",
        "activation": "onEnable",
        "healthCheck": {
          "method": "ping",
          "intervalMs": 5000,
          "timeoutMs": 1000
        }
      }
    ]
  },
  "contributes": {
    "commands": [],
    "services": [
      {
        "id": "native",
        "runtime": "sidecar:native-helper",
        "methods": ["ping"]
      }
    ],
    "settings": {}
  }
}
