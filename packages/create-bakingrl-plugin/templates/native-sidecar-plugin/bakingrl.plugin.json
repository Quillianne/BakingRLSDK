{
  "schema": "bakingrl.plugin/3",
  "kind": "trusted",
  "id": "__PLUGIN_ID__",
  "name": "__PLUGIN_NAME__",
  "version": "1.0.0",
  "author": "Your Name",
  "compatibility": {
    "runtimeApi": "__RUNTIME_API_VERSION__",
    "sdk": "__PLUGIN_SDK_VERSION__"
  },
  "runtime": {
    "extensionHost": {
      "entry": "dist/extension/index.js"
    },
    "sidecars": {
      "native-helper": {
        "command": "sidecars/native-helper/target/release/__PLUGIN_SLUG__-sidecar",
        "args": [],
        "env": {},
        "platforms": ["darwin", "linux"],
        "protocol": "jsonrpc-stdio",
        "activation": "onActivation"
      }
    }
  },
  "activation": {
    "events": ["onStartup"]
  },
  "contributes": {
    "commands": {},
    "services": {
      "native": {
        "title": "Native Helper",
        "sidecar": "native-helper",
        "methods": ["ping"]
      }
    },
    "visuals": {},
    "views": {},
    "pages": {},
    "overlays": {},
    "webviews": {},
    "configuration": {},
    "assets": {},
    "schemas": {}
  },
  "capabilities": {
    "permissions": {
      "bus": {
        "read": [],
        "publish": ["plugin.__PLUGIN_ID__.*"]
      },
      "registry": {
        "read": [],
        "write": []
      },
      "network": {
        "http": [],
        "websocket": []
      },
      "storage": ["plugin://self/*"]
    }
  },
  "diagnostics": {
    "enabled": true
  }
}
