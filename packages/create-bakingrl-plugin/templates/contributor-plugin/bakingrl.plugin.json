{
  "schemaVersion": "bakingrl.plugin/4",
  "bakingrlApi": "2.3.0",
  "id": "__PLUGIN_ID__",
  "name": "__PLUGIN_NAME__",
  "version": "1.0.0",
  "author": "Your Name",
  "permissions": {
    "bus": { "read": [], "publish": [] },
    "registry": { "read": [], "write": [] },
    "network": { "http": [], "websocket": [], "listen": [] },
    "storage": { "read": [], "write": [] }
  },
  "dependencies": [
    {
      "packageId": "com.example.platform",
      "version": "^1.0.0"
    }
  ],
  "runtime": {
    "node": {
      "entry": "dist/extension/index.js"
    },
    "sidecars": []
  },
  "contributes": {
    "services": [
      {
        "id": "contributor",
        "runtime": "node",
        "methods": ["snapshot"]
      }
    ],
    "resources": [
      {
        "id": "contributionData",
        "path": "resources/contribution.json",
        "type": "application/json",
        "visibility": "public",
        "metadata": {
          "role": "contribution-data"
        }
      }
    ],
    "contributions": [
      {
        "id": "sample-contribution",
        "target": "com.example.platform/items",
        "kind": "item",
        "title": "__PLUGIN_NAME__ contribution",
        "service": "contributor",
        "resources": ["contributionData"],
        "metadata": {
          "category": "starter"
        }
      }
    ],
    "settings": {}
  }
}
