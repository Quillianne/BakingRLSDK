{
  "schema": "bakingrl.plugin/2",
  "id": "__PLUGIN_ID__",
  "name": "__PLUGIN_NAME__",
  "version": "1.0.0",
  "author": "Your Name",
  "compatibility": {
    "runtimeApi": "__RUNTIME_API_VERSION__",
    "sdk": "__PLUGIN_SDK_VERSION__"
  },
  "exports": {
    "visuals": {
      "scoreboard": {
        "entry": "dist/visuals/scoreboard.js",
        "defaultSize": [600, 90]
      }
    },
    "components": {
      "TeamBadge": {
        "entry": "dist/components/team-badge.js",
        "props": "src/components/team-badge/props.schema.json"
      }
    },
    "services": {
      "matchStats": {
        "entry": "dist/services/match-stats.js",
        "methods": ["snapshot", "reset"],
        "schema": "src/services/match-stats/methods.schema.json"
      }
    },
    "connectors": {
      "twitch": {
        "entry": "dist/connectors/twitch.js"
      }
    }
  },
  "imports": {
    "components": [],
    "services": []
  },
  "permissions": {
    "bus": {
      "read": ["UpdateState", "GoalScored"],
      "publish": ["plugin.__PLUGIN_ID__.*"]
    },
    "registry": {
      "read": [],
      "write": ["plugin.__PLUGIN_ID__.*"]
    },
    "network": {
      "http": ["api.twitch.tv"],
      "websocket": []
    },
    "storage": ["plugin://self/*"]
  }
}
